{
  "scripts": {
    "dev": "npm run build:catalog && npm --prefix backend run dev",
    "build:catalog": "vite build && vite build --config vite.printer.config.mjs",
    "build": "npm run build:catalog && npm --prefix backend run build",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "test:browser": "playwright test",
    "android:sync": "npm run build:catalog && node scripts/prepare-android.mjs && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@delicity/capacitor-thermal-printer": "8.3.1",
    "antd": "^5.29.3",
    "dayjs": "^1.11.21",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "vite": "^7.3.6"
  }
}
