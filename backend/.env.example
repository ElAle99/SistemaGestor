NODE_ENV=
PORT=
JWT_SECRET=

# PostgreSQL runtime connection string. Never use an administrative login.
DATABASE_URL=
# Runtime only: sistema_gestor_app LOGIN, non-owner, NOSUPERUSER/NOBYPASSRLS.
# Administrative CLI only; never used by server.js or request services.
MIGRATION_DATABASE_URL=

# Optional legacy/local PostgreSQL fields. Ignored when DATABASE_URL exists.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# PostgreSQL SSL. Railway usually works through DATABASE_URL without forcing this.
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=

# CORS. Comma-separated frontend origins, no trailing slash.
FRONTEND_URL=
ALLOWED_ORIGINS=
CORS_CREDENTIALS=false

# Pool tuning.
DB_POOL_MAX=
DB_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# Administrative bootstrap only. The HTTP server never runs these tasks.
DB_RUN_LEGACY_CLEANUP=
SEED_DEFAULT_ADMIN=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
INITIAL_BUSINESS_NAME=
CONFIRM_EMPTY_DATABASE=

# Public registration for non-administrator roles only. Keep false unless needed.
ALLOW_USER_CREATION=false

# Password recovery email. Do not commit real credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_APP_URL=

# Private catalog scope for this legacy single-business installation.
# Use a distinct positive ID per business. A usuarios.negocio_id column, if present,
# always overrides this setting (including null, which disables private writes).
CATALOGO_NEGOCIO_ID=1
