NODE_ENV=
PORT=
JWT_SECRET=

# Railway PostgreSQL or any PostgreSQL connection string.
DATABASE_URL=

# Optional legacy/local PostgreSQL fields. Ignored when DATABASE_URL exists.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# PostgreSQL SSL. Railway usually works through DATABASE_URL without forcing this.
DB_SSL=
DB_SSL_REJECT_UNAUTHORIZED=

# CORS. Comma-separated frontend origins, no trailing slash.
FRONTEND_URL=
ALLOWED_ORIGINS=

# Pool tuning.
DB_POOL_MAX=
DB_IDLE_TIMEOUT_MS=
DB_CONNECTION_TIMEOUT_MS=

# Startup data tasks. Keep false in production unless you intentionally need them.
DB_RUN_LEGACY_CLEANUP=
SEED_DEFAULT_ADMIN=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Temporary public user creation recovery switch. Keep false in production.
ALLOW_USER_CREATION=false

# Password recovery email. Do not commit real credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_APP_URL=

# Chatbot n8n webhook. Optional; defaults to the production AllFix webhook.
N8N_CHAT_WEBHOOK_URL=
